<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_dark_charcoal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Hero Visual Graphic -->
        <ImageView
            android:id="@+id/ivHeroGraphic"
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:contentDescription="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/hero_slide_1" />

        <!-- Step Tag -->
        <TextView
            android:id="@+id/tvStepTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.15"
            android:textColor="@color/sand_accent"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ivHeroGraphic"
            tools:text="STEP 01 • SYSTEM BASELINE" />

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/text_primary_white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStepTag"
            tools:text="Rest Soundly. Arrive Right." />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2"
            android:textColor="@color/text_secondary_muted"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle"
            tools:text="Intelligent geofenced transit telemetry wake-ups. Never miss your interchange while catching deep sleep on trains or buses." />

        <!-- Feature Card 1 -->
        <LinearLayout
            android:id="@+id/card1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvDescription">

            <!-- Icon Container -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:id="@+id/ivCard1Icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    app:tint="@color/sand_accent"
                    tools:src="@drawable/ic_radar" />
            </FrameLayout>

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCard1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Adaptive Geofence Perimeter" />

                <TextView
                    android:id="@+id/tvCard1Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary_muted"
                    android:textSize="11sp"
                    tools:text="Expands alert buffer if transit exceeds 50 km/h." />
            </LinearLayout>

            <!-- Right Badge or Switch -->
            <TextView
                android:id="@+id/tvCard1Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05"
                android:textColor="@color/sand_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="AUTO-SCALE"
                tools:visibility="visible" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchCard1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:visibility="gone" />

        </LinearLayout>

        <!-- Feature Card 2 -->
        <LinearLayout
            android:id="@+id/card2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card1">

            <!-- Icon Container -->
            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_icon_container">

                <ImageView
                    android:id="@+id/ivCard2Icon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    app:tint="@color/sand_accent"
                    tools:src="@drawable/ic_shield_check" />
            </FrameLayout>

            <!-- Text Content -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCard2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Zero Cloud Storage" />

                <TextView
                    android:id="@+id/tvCard2Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_secondary_muted"
                    android:textSize="11sp"
                    tools:text="Location processed entirely on device silicon." />
            </LinearLayout>

            <!-- Right Badge or Text -->
            <TextView
                android:id="@+id/tvCard2Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05"
                android:textColor="@color/sand_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="100% PRIVATE"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvCard2Value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sand_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="&lt; 1.5% / hour" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>